---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagList from '../../components/TagList.astro';
import { getAllTags } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const tags = getAllTags(allPosts);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const allPosts = (await getCollection('posts')).sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

const filteredPosts = allPosts.filter((p) => p.data.tags.includes(tag));
const allTags = getAllTags(allPosts);

const pageTitle = `Posts Tagged #${tag} | AWS & DevOps Guides | Mausam Giri`;
const pageDescription = `Practical AWS, EKS, and DevOps runbooks, architecture patterns, and troubleshooting guides tagged with #${tag} by Mausam Giri.`;
const canonicalUrl = `https://mausamgiri.in/blogs/tags/${encodeURIComponent(tag)}/`;
const breadcrumbs = [
  { name: 'Home', url: 'https://mausamgiri.in/blogs/' },
  { name: 'Tags', url: 'https://mausamgiri.in/blogs/tags/' },
  { name: `#${tag}`, url: canonicalUrl },
];

const intros: Record<string, string> = {
  eks: 'Production Kubernetes operations on AWS: Karpenter autoscaling, cluster upgrades, Kyverno policy enforcement, and multi-tenant networking.',
  ecs: 'Amazon ECS on AWS Fargate: Service Connect service mesh, task definitions, CloudWatch container insights, and traffic routing.',
  vpc: 'Amazon VPC network architecture: Transit Gateways, centralized egress firewalls, private endpoints, and cross-account routing.',
  'vpc-lattice': 'Amazon VPC Lattice application networking: service networks, HTTP route rules, IAM auth policies, and cross-cluster service mesh.',
  lambda: 'AWS Lambda serverless runtimes: Python/Node execution environments, RDS IAM authentication, API integrations, and event processing.',
  bedrock: 'Amazon Bedrock generative AI runbooks: AgentCore architectures, RAG knowledge bases, DynamoDB streams, and enterprise AI safety.',
  iam: 'AWS Identity & Access Management: least-privilege policy conditions, ABAC, role delegation, cross-account access, and credential triage.',
  cicd: 'Automated CI/CD pipelines on AWS: CodePipeline v2, CodeBuild environments, GitOps with Argo CD, and container image release workflows.',
  security: 'Cloud security hardening: KMS envelope encryption, ACM certificates, WAF rules, and security compliance patterns.',
};

const tagIntro = intros[tag.toLowerCase()] || `Collection of console-first runbooks, architecture walk-throughs, and production debugging guides tagged with #${tag}.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  posts={allPosts}
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <div class="container landing">
    <section class="posts">
      <header class="tag-header">
        <nav class="tag-breadcrumb" aria-label="Breadcrumb">
          <a href={withBase()}>Home</a>
          <span class="sep">/</span>
          <span class="current">Tags</span>
          <span class="sep">/</span>
          <span class="current">#{tag}</span>
        </nav>
        <div class="tag-title-row">
          <h1>#{tag}</h1>
          <span class="tag-badge">{filteredPosts.length} {filteredPosts.length === 1 ? 'guide' : 'guides'}</span>
        </div>
        <p class="tag-desc">{tagIntro}</p>
      </header>

      <div class="posts-list">
        {filteredPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
    <TagList tags={allTags} totalCount={allPosts.length} initialTags={[tag]} />
  </div>
</BaseLayout>

<style>
  .landing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: 3rem;
    padding: 2.5rem 0 0;
  }
  .tag-header {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .tag-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .tag-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .tag-breadcrumb a:hover {
    color: var(--accent);
  }
  .tag-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .tag-header h1 {
    margin: 0;
    font-size: var(--text-2xl);
    line-height: 1.2;
    color: var(--text);
    font-family: var(--font-mono);
  }
  .tag-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: var(--bg-subtle);
  }
  .tag-desc {
    margin: 0.5rem 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 48rem;
  }
  .posts-list {
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 48rem) {
    .landing {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
