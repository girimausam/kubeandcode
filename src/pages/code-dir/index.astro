---
import { isTextFile, pathsToTree } from '../../utils/code-dir';
import { withBase } from '../../utils/url';

const files = Object.keys(import.meta.glob('../../content/dir/**/*'))
	.map((key) => key.replace('../../content/dir/', ''))
	.filter(isTextFile);
const tree = pathsToTree(files);
const fileBase = withBase('content/dir/');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>dir</title>
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<script is:inline>
			(function () {
				var theme =
					localStorage.getItem('theme') ||
					(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<style is:global>
			:root {
				--bg: #f4f5f7;
				--panel: #fff;
				--text: #1c1d21;
				--muted: #6b7280;
				--line: #e5e7eb;
				--on: #e8eef8;
				--hover: #f3f4f6;
				--mono: ui-monospace, 'IBM Plex Mono', Menlo, Consolas, monospace;
			}
			:root[data-theme='dark'] {
				--bg: #0c0d10;
				--panel: #14151a;
				--text: #eceef2;
				--muted: #9ca3af;
				--line: #2a2c33;
				--on: #243044;
				--hover: #1c1e26;
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				height: 100%;
				background: var(--bg);
				color: var(--text);
				font: 13px/1.4 ui-sans-serif, system-ui, sans-serif;
			}
			.browser {
				height: 100%;
				display: grid;
				grid-template-rows: 2.5rem 1fr;
			}
			.bar {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				padding: 0 0.75rem;
				border-bottom: 1px solid var(--line);
				background: var(--panel);
				font-size: 12px;
			}
			.bar b {
				font-weight: 650;
				letter-spacing: -0.02em;
			}
			.crumb {
				min-width: 0;
				flex: 1;
				color: var(--muted);
				font-family: var(--mono);
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.bar button {
				flex-shrink: 0;
				border: 1px solid var(--line);
				border-radius: 6px;
				background: var(--bg);
				color: var(--text);
				cursor: pointer;
				font: inherit;
				padding: 0.2rem 0.55rem;
			}
			.bar button:hover {
				background: var(--hover);
			}
			.split {
				display: grid;
				grid-template-columns: minmax(14rem, var(--tree-w, 18rem)) 6px 1fr;
				min-height: 0;
			}
			.tree {
				min-width: 14rem;
				overflow: auto;
				background: var(--panel);
				padding: 0.45rem 0.35rem 0.75rem;
			}
			.gutter {
				cursor: col-resize;
				background: var(--line);
			}
			.gutter:hover,
			.gutter.drag {
				background: var(--muted);
			}
			.tree details {
				padding-left: 0.15rem;
			}
			.tree .kids {
				margin-left: 0.55rem;
				padding-left: 0.45rem;
				border-left: 1px solid var(--line);
			}
			.tree summary,
			.tree .file {
				appearance: none;
				-webkit-appearance: none;
				display: flex;
				align-items: center;
				gap: 0.4rem;
				width: 100%;
				box-sizing: border-box;
				margin: 0;
				text-align: left;
				text-decoration: none;
				border: 0;
				border-radius: 4px;
				background: transparent;
				color: var(--text);
				font: 12px/1.45 var(--mono);
				padding: 0.16rem 0.4rem 0.16rem 0.2rem;
				cursor: pointer;
			}
			.tree summary {
				color: var(--muted);
				list-style: none;
			}
			.tree summary::-webkit-details-marker {
				display: none;
			}
			.tree summary::before {
				content: '▸';
				display: inline-block;
				width: 0.85rem;
				color: var(--muted);
				font-size: 10px;
			}
			.tree details[open] > summary::before {
				content: '▾';
			}
			.tree .file::before {
				content: '';
				width: 0.55rem;
				height: 0.55rem;
				border-radius: 2px;
				background: var(--line);
				flex-shrink: 0;
			}
			.tree summary:hover,
			.tree .file:hover {
				background: var(--hover);
			}
			.tree .file.on {
				background: var(--on);
			}
			.pane {
				overflow: auto;
				background: var(--bg);
			}
			.hint {
				padding: 1.25rem 1rem;
				color: var(--muted);
				font-family: var(--mono);
				font-size: 12px;
			}
			.pane pre {
				margin: 0;
				padding: 1rem 1.1rem;
				font: 12.5px/1.55 var(--mono);
				background: transparent !important;
			}
			.pane code {
				font-family: inherit;
			}
			.raw {
				margin: 0;
				padding: 1rem 1.1rem;
				white-space: pre;
				font: 12.5px/1.55 var(--mono);
			}
			@media (max-width: 720px) {
				.split {
					grid-template-columns: 1fr;
					grid-template-rows: minmax(10rem, 32vh) 0 1fr;
				}
				.gutter {
					display: none;
					cursor: default;
				}
			}
		</style>
	</head>
	<body>
		<div class="browser">
			<div class="bar">
				<b>dir</b>
				<span class="crumb" data-path-label>src/content/dir</span>
				<button type="button" data-theme-toggle>Theme</button>
			</div>
			<div class="split">
				<nav class="tree" data-tree></nav>
				<div class="gutter" data-gutter></div>
				<div class="pane" data-view><p class="hint">Select a file</p></div>
			</div>
		</div>
		<script>
			document.querySelector('[data-theme-toggle]')?.addEventListener('click', (event) => {
				event.stopPropagation();
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				localStorage.setItem('theme', next);
			});

			const split = document.querySelector('.split');
			const gutter = document.querySelector('[data-gutter]');
			const minW = 224;
			let drag = false;
			gutter?.addEventListener('pointerdown', (e) => {
				drag = true;
				gutter.classList.add('drag');
				gutter.setPointerCapture(e.pointerId);
			});
			gutter?.addEventListener('pointermove', (e) => {
				if (!drag || !split) return;
				const left = split.getBoundingClientRect().left;
				const max = Math.min(split.clientWidth * 0.7, split.clientWidth - 160);
				const w = Math.min(max, Math.max(minW, e.clientX - left));
				split.style.setProperty('--tree-w', `${w}px`);
			});
			gutter?.addEventListener('pointerup', () => {
				drag = false;
				gutter?.classList.remove('drag');
			});
		</script>
		<script define:vars={{ payload: { tree, files, fileBase } }}>
			window.__CODE_DIR = payload;
		</script>
		<script>
			const { initCodeDir } = await import('../../scripts/code-dir-app');
			initCodeDir(window.__CODE_DIR);
		</script>
	</body>
</html>
