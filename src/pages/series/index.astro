---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SERIES_LIST } from '../../data/series';
import { withBase } from '../../utils/url';

const posts = await getCollection('posts');
const title = 'AWS, EKS & DevOps Runbook Series | Mausam Giri';
const description = 'Structured, step-by-step AWS and Kubernetes reading curriculums: EKS, ECS, VPC Lattice, ECR, Cognito, Bedrock AgentCore, and CI/CD pipelines.';
const canonicalUrl = 'https://mausamgiri.in/blogs/series/';
---

<BaseLayout title={title} description={description} posts={posts} canonicalUrl={canonicalUrl}>
  <div class="container series-index">
    <header class="series-header">
      <div class="badge">Curated Learning Paths</div>
      <h1>AWS & DevOps Series Hubs</h1>
      <p class="lead">
        Follow structured, console-first reading orders designed to take you from foundational concepts to production-grade architectures and operational runbooks.
      </p>
    </header>

    <div class="series-grid">
      {
        SERIES_LIST.map((series) => (
          <article class="series-card">
            <div class="series-card-header">
              <span class="series-badge">{series.badge}</span>
              <span class="series-count">{series.guides.length} Guides</span>
            </div>
            <h2>
              <a href={withBase(`series/${series.slug}/`)}>{series.title}</a>
            </h2>
            <p>{series.description}</p>
            <div class="series-card-footer">
              <a class="read-series-btn" href={withBase(`series/${series.slug}/`)}>
                Explore Series &rarr;
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .series-index {
    padding: 3rem 0;
  }
  .series-header {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto 3rem;
  }
  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--accent-muted);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
  h1 {
    font-size: var(--text-3xl);
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }
  .lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 1.5rem;
  }
  .series-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg);
    transition: border-color 0.15s, transform 0.15s;
  }
  .series-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .series-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .series-badge {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .series-count {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .series-card h2 {
    margin: 0 0 0.75rem;
    font-size: var(--text-xl);
    line-height: 1.3;
  }
  .series-card h2 a {
    color: var(--text);
    text-decoration: none;
  }
  .series-card h2 a:hover {
    color: var(--accent);
  }
  .series-card p {
    margin: 0 0 1.5rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.55;
    flex-grow: 1;
  }
  .series-card-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .read-series-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .read-series-btn:hover {
    text-decoration: underline;
  }
</style>

