---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { CATEGORIES } from "../data/categories";
import { withBase } from "../utils/url";

const allPosts = await getCollection("posts");

// Sort posts by date descending
const sortedPosts = allPosts.sort((a, b) => {
	const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
	const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
	return dateB - dateA;
});

const latestPosts = sortedPosts.slice(0, 15);

// Count posts per category
const categoryCounts = new Map<string, number>();
for (const cat of CATEGORIES) {
	const count = allPosts.filter((p) =>
		p.data.tags.some((t) => cat.tags.includes(t.toLowerCase())),
	).length;
	categoryCounts.set(cat.id, count);
}

const title = "AWS, EKS & DevOps Guides: Console-First Runbooks | Mausam Giri";
const description =
	"Practical AWS, EKS, and DevOps runbooks with console-first workflows, architecture patterns, and production troubleshooting guides by Mausam Giri.";
const canonicalUrl = "https://mausamgiri.in/blogs/";
---

<BaseLayout
	title={title}
	description={description}
	posts={allPosts}
	canonicalUrl={canonicalUrl}
>
	<div class="container home">
		<!-- Hero Section -->
		<section class="hero">
			<div class="hero-badge">Architecture &amp; Runbooks</div>
			<h1>AWS, EKS &amp; DevOps Engineering Guides</h1>
			<p class="hero-subtitle">
				Console-first workflows, infrastructure patterns, and debugging
				playbooks built for cloud and platform engineers.
			</p>
		</section>

		<!-- Category Hubs Grid -->

		<!-- Latest 15 Posts -->
		<section class="latest-section" aria-labelledby="latest-heading">
			<div class="section-header">
				<div>
					<h2 id="latest-heading">Latest Runbooks</h2>
					<p class="section-desc">
						Recently updated engineering and troubleshooting guides
					</p>
				</div>
				<a href={withBase("posts/")} class="view-all-link desktop-only">
					View all {allPosts.length} guides <span
						class="material-symbols-outlined">arrow_forward</span
					>
				</a>
			</div>

			<div class="posts-list">
				{latestPosts.map((post) => <PostCard post={post} />)}
			</div>

			<div class="bottom-action">
				<a href={withBase("posts/")} class="btn-archive">
					Browse all {allPosts.length} posts grouped by year
					<span class="material-symbols-outlined">arrow_forward</span>
				</a>
			</div>
		</section>

		<section class="categories-section" aria-labelledby="cat-heading">
			<div class="section-header">
				<h2 id="cat-heading">Category Hubs</h2>
				<span class="section-count">{CATEGORIES.length} domains</span>
			</div>
			<div class="categories-grid">
				{
					CATEGORIES.map((cat) => {
						const count = categoryCounts.get(cat.id) ?? 0;
						return (
							<a
								href={withBase(`tags/${cat.tag}/`)}
								class="category-card"
							>
								<div class="category-top">
									<span class="category-name">
										{cat.name}
									</span>
									<span class="category-count">
										{count}{" "}
										{count === 1 ? "guide" : "guides"}
									</span>
								</div>
								<p class="category-desc">{cat.description}</p>
							</a>
						);
					})
				}
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.home {
		padding: 1.5rem 0 2.5rem;
	}

	/* Hero */
	.hero {
		margin-bottom: 1.75rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--border);
	}

	.hero-badge {
		display: inline-block;
		margin-bottom: 0.5rem;
		padding: 0.15rem 0.55rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		font-weight: 500;
		color: var(--accent);
		background: var(--bg-subtle);
		letter-spacing: 0.02em;
	}

	.hero h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.025em;
		color: var(--text);
	}

	.hero-subtitle {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--text-muted);
		line-height: 1.5;
		/* max-width: 44rem; */
	}

	/* Section Header */
	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--border);
	}

	.section-header h2 {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--text);
	}

	.section-count,
	.section-desc {
		margin: 0.15rem 0 0;
		font-size: var(--text-xs);
		color: var(--text-muted);
		font-family: var(--font-mono);
	}

	.view-all-link {
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--accent);
		text-decoration: none;
		white-space: nowrap;
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.view-all-link:hover {
		text-decoration: underline;
	}

	/* Categories Grid */
	.categories-section {
		margin-bottom: 2rem;
	}

	.categories-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
		gap: 0.75rem;
	}

	.category-card {
		display: flex;
		flex-direction: column;
		padding: 0.85rem 1rem;
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		background: var(--bg);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.category-card:hover {
		border-color: var(--accent);
		background: var(--bg-subtle);
	}

	.category-top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.35rem;
	}

	.category-name {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--text);
		letter-spacing: -0.01em;
	}

	.category-count {
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		color: var(--text-muted);
	}

	.category-desc {
		margin: 0 0 0.75rem;
		font-size: var(--text-xs);
		color: var(--text-muted);
		line-height: 1.45;
		flex-grow: 1;
	}

	.category-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--accent);
	}

	/* Latest Section */
	.posts-list {
		display: flex;
		flex-direction: column;
		margin-bottom: 1.25rem;
	}

	.bottom-action {
		display: flex;
		justify-content: center;
		padding: 1.25rem 0 0.5rem;
	}

	.btn-archive {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.55rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		background: var(--bg-subtle);
		color: var(--text);
		font-size: var(--text-xs);
		font-weight: 500;
		font-family: var(--font-mono);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.btn-archive:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	@media (max-width: 48rem) {
		.desktop-only {
			display: none;
		}
		.categories-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
