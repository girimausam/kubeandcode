---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>404</title>
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<script is:inline>
			(function () {
				const theme =
					localStorage.getItem('theme') ||
					(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<style>
			:root {
				--bg: #fff;
				--text: #222;
				--muted: #888;
			}
			:root[data-theme='dark'] {
				--bg: #111;
				--text: #eee;
				--muted: #777;
			}
			html,
			body {
				margin: 0;
				height: 100%;
				background: var(--bg);
				color: var(--text);
				font: 15px/1.4 ui-sans-serif, system-ui, sans-serif;
			}
			main {
				min-height: 100%;
				display: grid;
				place-content: center;
				text-align: center;
				gap: 0.35rem;
			}
			h1 {
				margin: 0;
				font-size: 1.25rem;
				font-weight: 600;
			}
			p {
				margin: 0;
				color: var(--muted);
			}
			a {
				color: inherit;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>404</h1>
			<p>Not found</p>
			<p><a href={base}>Home</a></p>
		</main>
	</body>
</html>
