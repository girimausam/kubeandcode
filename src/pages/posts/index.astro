---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { withBase } from '../../utils/url';

const allPosts = await getCollection('posts');

// Sort posts by date descending
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

// Group posts by year
const postsByYear = new Map<number, typeof sortedPosts>();
for (const post of sortedPosts) {
  const year = post.data.date ? new Date(post.data.date).getUTCFullYear() : new Date().getUTCFullYear();
  const list = postsByYear.get(year) ?? [];
  list.push(post);
  postsByYear.set(year, list);
}

const years = [...postsByYear.keys()].sort((a, b) => b - a);

const title = 'All Guides & Runbooks | Mausam Giri';
const description = `Complete archive of ${allPosts.length} AWS, EKS, and DevOps runbooks, architecture patterns, and technical guides grouped by year.`;
const canonicalUrl = 'https://mausamgiri.in/blogs/posts/';
const breadcrumbs = [
  { name: 'Home', url: 'https://mausamgiri.in/blogs/' },
  { name: 'Posts', url: canonicalUrl },
];
---

<BaseLayout
  title={title}
  description={description}
  posts={allPosts}
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <div class="container posts-archive">
    <header class="archive-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={withBase()}>Home</a>
        <span class="sep">/</span>
        <span class="current">Posts</span>
      </nav>
      <div class="title-row">
        <h1>All Runbooks &amp; Guides</h1>
        <span class="total-badge">{allPosts.length} total</span>
      </div>
      <p class="subtitle">
        Chronological archive of all production walkthroughs, console-first runbooks, and cloud infrastructure guides.
      </p>

      {years.length > 1 && (
        <nav class="year-nav" aria-label="Jump to year">
          <span class="year-label">Jump to:</span>
          {years.map((year) => (
            <a href={`#year-${year}`} class="year-link">
              {year} ({postsByYear.get(year)?.length})
            </a>
          ))}
        </nav>
      )}
    </header>

    <div class="years-container">
      {years.map((year) => {
        const yearPosts = postsByYear.get(year) ?? [];
        return (
          <section id={`year-${year}`} class="year-group" aria-labelledby={`heading-${year}`}>
            <div class="year-sticky-header">
              <h2 id={`heading-${year}`}>{year}</h2>
              <span class="year-count">{yearPosts.length} {yearPosts.length === 1 ? 'guide' : 'guides'}</span>
            </div>
            <div class="posts-list">
              {yearPosts.map((post) => <PostCard post={post} />)}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .posts-archive {
    padding: 1.5rem 0 2.5rem;
  }

  .archive-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .title-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  h1 {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
  }

  .total-badge {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: var(--bg-subtle);
  }

  .subtitle {
    margin: 0 0 1rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .year-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .year-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .year-link {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--text);
    text-decoration: none;
    background: var(--bg);
    transition: border-color 0.15s ease;
  }

  .year-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .years-container {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .year-group {
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  .year-sticky-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }

  .year-sticky-header h2 {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text);
  }

  .year-count {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
  }
</style>
