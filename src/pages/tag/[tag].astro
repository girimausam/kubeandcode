---
import { getCollection } from 'astro:content';
import { getAllTags } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const tags = getAllTags(allPosts);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const targetUrl = withBase(`tags/${encodeURIComponent(tag)}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href={`https://mausamgiri.in/blogs/tags/${encodeURIComponent(tag)}/`} />
    <title>Redirecting to #{tag}...</title>
    <script is:inline define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={targetUrl}>#{tag}</a>...</p>
  </body>
</html>
