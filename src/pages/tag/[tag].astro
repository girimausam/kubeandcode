---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagList from '../../components/TagList.astro';
import { getAllTags } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const tags = getAllTags(allPosts);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const allPosts = (await getCollection('posts')).sort(
  (a, b) => (a.data.title ?? '').localeCompare(b.data.title ?? '')
);
const filteredPosts = allPosts.filter((p) => p.data.tags.includes(tag));
const allTags = getAllTags(allPosts);

const pageTitle = `Posts Tagged #${tag} | AWS & DevOps Guides | Mausam Giri`;
const pageDescription = `Browse practical AWS, EKS, and DevOps runbooks and technical guides tagged with #${tag} by Mausam Giri.`;
const canonicalUrl = `https://mausamgiri.in/blogs/tag/${encodeURIComponent(tag)}/`;
const breadcrumbs = [
  { name: 'Home', url: 'https://mausamgiri.in/blogs/' },
  { name: `Tag: #${tag}`, url: canonicalUrl }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  posts={allPosts}
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <main class="container landing">
    <section class="posts">
      <header class="tag-header">
        <nav class="tag-breadcrumb" aria-label="Breadcrumb">
          <a href={withBase()}>Home</a>
          <span class="sep">/</span>
          <span class="current">Tag</span>
        </nav>
        <h1>Tag: #{tag}</h1>
        <p class="tag-meta">{filteredPosts.length} guide{filteredPosts.length === 1 ? '' : 's'} found</p>
      </header>

      <div class="posts-list">
        {filteredPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
    <TagList tags={allTags} totalCount={allPosts.length} initialTags={[tag]} />
  </main>
</BaseLayout>

<style>
  .landing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: 3rem;
    padding: 2.5rem 0 0;
  }
  .tag-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .tag-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .tag-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .tag-breadcrumb a:hover {
    color: var(--accent);
  }
  .tag-header h1 {
    margin: 0 0 0.5rem;
    font-size: var(--text-2xl);
    line-height: 1.2;
    color: var(--text);
  }
  .tag-meta {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  @media (max-width: 48rem) {
    .landing {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

