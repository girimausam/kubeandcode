---
import type { Post } from "../utils/posts";
import { formatDate } from "../utils/posts";
import PostTags from "./PostTags.astro";
import { withBase } from "../utils/url";

interface Props {
	post: Post;
}

const { post } = Astro.props;
const href = withBase(`${post.id}/`);
const date = post.data.date ? new Date(post.data.date) : null;
const tags = (post.data.tags ?? []).slice(0, 3);
---

<article class="post-card" data-post-tags={post.data.tags.join(",")}>
	<a
		href={href}
		class="card-main-link"
		aria-label={`Read guide: ${post.data.title}`}
	>
		<div class="content">
			<div class="header">
				<h2>{post.data.title}</h2>
				{
					date && (
						<time hidden class="date" datetime={date.toISOString()}>
							{formatDate(date)}
						</time>
					)
				}
			</div>
			{
				post.data.description && (
					<p class="desc">{post.data.description}</p>
				)
			}
		</div>
		<div class="read-action" aria-hidden="true">
			<span class="read-text">Read</span>
			<span class="material-symbols-outlined arrow-icon"
				>arrow_forward</span
			>
		</div>
	</a>
	<div class="meta">
		<PostTags tags={tags} showHash />
	</div>
</article>

<style>
	.post-card {
		padding: 0.75rem 0.5rem;
		border-bottom: 1px solid var(--border);
		border-radius: 0.375rem;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;
	}

	.post-card:hover {
		background-color: var(--bg-subtle);
	}

	.card-main-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		text-decoration: none;
		color: inherit;
		cursor: pointer;
	}

	.content {
		flex: 1;
		min-width: 0;
	}

	.header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
	}

	h2 {
		margin: 0;
		font-size: var(--text-base);
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.01em;
		color: var(--text);
		transition: color 0.15s ease;
	}

	.card-main-link:hover h2 {
		color: var(--accent);
	}

	.date {
		font-size: var(--text-xs);
		color: var(--text-muted);
		font-family: var(--font-mono);
		white-space: nowrap;
		flex-shrink: 0;
	}

	.desc {
		margin: 0.25rem 0 0;
		font-size: var(--text-xs);
		color: var(--text-muted);
		line-height: 1.45;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Read button on the right */
	.read-action {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.35rem 0.65rem;
		border: 1px solid var(--border);
		border-radius: 0.35rem;
		background: var(--bg);
		color: var(--text-muted);
		font-size: var(--text-xs);
		font-weight: 500;
		font-family: var(--font-mono);
		white-space: nowrap;
		flex-shrink: 0;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.read-text {
		line-height: 1;
	}

	.arrow-icon {
		font-size: 14px;
		transition: transform 0.15s ease;
	}

	.card-main-link:hover .read-action {
		color: var(--accent);
		border-color: var(--accent);
		background: var(--bg);
	}

	.card-main-link:hover .arrow-icon {
		transform: translateX(3px);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.4rem;
	}

	@media (max-width: 40rem) {
		.card-main-link {
			gap: 0.75rem;
		}

		.header {
			flex-direction: column;
			gap: 0.15rem;
		}

		.read-action {
			padding: 0.3rem 0.5rem;
		}
	}
</style>
