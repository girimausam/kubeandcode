---
import type { Post } from '../utils/posts';
import PostTags from './PostTags.astro';
import { withBase } from '../utils/url';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const href = withBase(`${post.id}/`);
---

<article class="post-card" data-post-tags={post.data.tags.join(',')}>
	<h2>
		<a href={href}>{post.data.title}</a>
	</h2>
	<p>{post.data.description}</p>
	<div class="meta">
		<PostTags tags={post.data.tags} showHash />
	</div>
</article>

<style>
	.post-card {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border);
	}

	.post-card:first-child {
		padding-top: 0;
	}

	h2 {
		margin: 0;
		font-size: var(--text-xl);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	p {
		margin: 0.5rem 0 0;
		color: var(--text-muted);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
		margin-top: 0.25rem;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}
</style>
