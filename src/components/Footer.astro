---
import type { Post } from '../utils/posts';
import { withBase } from '../utils/url';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-grid">
			<div class="footer-about">
				<p class="footer-title">AWS, EKS &amp; DevOps Guides</p>
				<p class="footer-desc">
					Console-first engineering runbooks, architecture deep-dives, and production playbooks by Mausam Giri.
				</p>
			</div>

			<nav class="footer-nav" aria-label="Footer Navigation">
				<span class="nav-heading">Explore</span>
				<a href={withBase()}>Home</a>
				<a href={withBase('posts/')}>All Posts ({posts.length})</a>
				<a href={withBase('series/')}>Curriculum Series</a>
				<a href={withBase('about/')}>About Mausam Giri</a>
			</nav>

			<nav class="footer-nav" aria-label="External Profiles">
				<span class="nav-heading">Connect</span>
				<a href="https://github.com/mausamgiri" target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href="https://linkedin.com/in/mausamgiri" target="_blank" rel="noopener noreferrer">LinkedIn</a>
				<a href="https://mausamgiri.in" target="_blank" rel="noopener noreferrer">mausamgiri.in</a>
				<a href={withBase('feed.xml')}>RSS Feed</a>
			</nav>
		</div>

		<div class="footer-bottom">
			<p>© {year} Mausam Giri. All rights reserved.</p>
			<div class="footer-meta">
				<span id="utc-time"></span> <span class="utc-label">UTC</span>
			</div>
		</div>
	</div>
</footer>

<script is:inline>
	const el = document.getElementById('utc-time');
	const tick = () => {
		if (!el) return;
		el.textContent = new Date().toISOString().replace('T', ' ').slice(0, 19);
	};
	tick();
	setInterval(tick, 1000);
</script>

<style>
	.site-footer {
		margin-top: auto;
		padding: 3rem 0 1.5rem;
		border-top: 1px solid var(--border);
		background: var(--bg-subtle);
		font-size: var(--text-sm);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 2.5rem;
		margin-bottom: 2.5rem;
	}

	.footer-title {
		margin: 0 0 0.5rem;
		font-weight: 600;
		color: var(--text);
	}

	.footer-desc {
		margin: 0;
		font-size: var(--text-xs);
		color: var(--text-muted);
		line-height: 1.6;
		max-width: 24rem;
	}

	.footer-nav {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.nav-heading {
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text);
		margin-bottom: 0.25rem;
	}

	.footer-nav a {
		font-size: var(--text-xs);
		color: var(--text-muted);
		text-decoration: none;
		min-height: 24px;
		display: inline-flex;
		align-items: center;
	}

	.footer-nav a:hover {
		color: var(--accent);
	}

	.footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		font-size: var(--text-xs);
		color: var(--text-muted);
		font-family: var(--font-mono);
	}

	.footer-bottom p {
		margin: 0;
	}

	.utc-label {
		color: var(--text-muted);
		opacity: 0.7;
	}

	@media (max-width: 48rem) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
