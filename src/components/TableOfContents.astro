---
export interface TocHeading {
	depth: number;
	text: string;
	slug: string;
}

interface Props {
	headings: TocHeading[];
}

const { headings } = Astro.props;
---

{
	headings.length > 0 && (
		<div class="toc-root" data-toc-root>
			<div class="toc-backdrop" data-toc-backdrop hidden />

			<button
				type="button"
				class="toc-fab"
				data-toc-fab
				aria-expanded="false"
				aria-controls="toc-nav"
				aria-label="Show table of contents"
				hidden
			>
				<svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M3 4.5h10M3 8h10M3 11.5h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
				</svg>
			</button>

			<aside class="toc-panel" data-toc-panel aria-label="Table of contents">
				<header class="toc-header">
					<p class="toc-label">On this page</p>
					<button
						type="button"
						class="toc-toggle"
						data-toc-toggle
						aria-expanded="true"
						aria-controls="toc-nav"
						aria-label="Hide table of contents"
					>
						<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
							<path
								d="M10 4L6 8l4 4"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</button>
				</header>

				<nav class="toc-nav" id="toc-nav">
					<ol class="toc-list">
						{headings.map((heading) => (
							<li class={`toc-item depth-${heading.depth}`}>
								<a href={`#${heading.slug}`} class="toc-link">
									{heading.text}
								</a>
							</li>
						))}
					</ol>
				</nav>
			</aside>
		</div>
	)
}

<script>
	import Gumshoe from 'gumshoejs';

	const STORAGE_KEY = 'toc-collapsed';
	const DESKTOP_QUERY = '(min-width: 1100px)';

	let spy: InstanceType<typeof Gumshoe> | undefined;

	const isDesktop = () => window.matchMedia(DESKTOP_QUERY).matches;

	const setCollapsed = (root: HTMLElement, collapsed: boolean) => {
		const fab = root.querySelector<HTMLButtonElement>('[data-toc-fab]');
		const toggle = root.querySelector<HTMLButtonElement>('[data-toc-toggle]');
		const backdrop = root.querySelector<HTMLElement>('[data-toc-backdrop]');

		root.toggleAttribute('data-collapsed', collapsed);

		if (fab) {
			fab.hidden = !collapsed;
			fab.setAttribute('aria-expanded', String(!collapsed));
		}

		if (toggle) {
			toggle.setAttribute('aria-expanded', String(!collapsed));
			toggle.setAttribute('aria-label', collapsed ? 'Show table of contents' : 'Hide table of contents');
		}

		if (backdrop) {
			backdrop.hidden = collapsed || isDesktop();
		}

		if (isDesktop()) {
			sessionStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0');
		}
	};

	const initToc = () => {
		const root = document.querySelector<HTMLElement>('[data-toc-root]');
		const fab = root?.querySelector<HTMLButtonElement>('[data-toc-fab]');
		const toggle = root?.querySelector<HTMLButtonElement>('[data-toc-toggle]');
		const backdrop = root?.querySelector<HTMLElement>('[data-toc-backdrop]');
		const nav = root?.querySelector('#toc-nav');

		if (!root || !fab || !toggle || !nav) return;

		spy?.destroy();
		spy = new Gumshoe('#toc-nav a', {
			offset: 88,
			reflow: true,
			nested: true,
			nestedClass: 'active',
			navClass: 'active',
		});

		const desktop = isDesktop();
		const stored = sessionStorage.getItem(STORAGE_KEY);
		const startCollapsed = desktop ? stored === '1' : true;
		setCollapsed(root, startCollapsed);

		if (!root.dataset.bound) {
			root.dataset.bound = 'true';

			const open = () => setCollapsed(root, false);
			const close = () => setCollapsed(root, true);

			fab.addEventListener('click', open);
			toggle.addEventListener('click', close);
			backdrop?.addEventListener('click', close);

			nav.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					if (!isDesktop()) close();
				});
			});

			window.matchMedia(DESKTOP_QUERY).addEventListener('change', (event) => {
				if (event.matches) {
					const saved = sessionStorage.getItem(STORAGE_KEY);
					setCollapsed(root, saved === '1');
				} else {
					setCollapsed(root, true);
				}
			});
		}
	};

	initToc();
	document.addEventListener('astro:page-load', initToc);
</script>

<style>
	.toc-root {
		position: fixed;
		top: calc(var(--header-height) + 1.5rem);
		/* right: max(1rem, calc((100vw - var(--max-width)) / 2 + 1rem)); */
		right: 1rem;
		z-index: 5;
		font-size: var(--text-sm);
		line-height: 1.45;
	}

	.toc-fab {
		background: var(--bg);
		border: 1px solid var(--border);
		padding: 0.25rem 0.5rem;
		border-radius: 0.5rem;
	}

	.toc-fab:hover {
		color: var(--text);
		border-color: var(--accent);
	}

	.toc-panel {
		display: flex;
		flex-direction: column;
		width: 17.5rem;
		max-height: calc(100vh - var(--header-height) - 3rem);
		padding: 0.85rem 1rem;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background: var(--bg);
		/* box-shadow: 0 4px 24px color-mix(in srgb, var(--text) 10%, transparent); */
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.toc-root[data-collapsed] .toc-panel {
		position: absolute;
		top: 0;
		right: 0;
		opacity: 0;
		transform: translateX(calc(100% + 0.75rem));
		pointer-events: none;
	}

	.toc-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.65rem;
		flex-shrink: 0;
	}

	.toc-label {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.toc-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		background: var(--bg);
		color: var(--text-muted);
		cursor: pointer;
		transition:
			color 0.15s,
			border-color 0.15s;
	}

	.toc-toggle:hover {
		color: var(--text);
		border-color: var(--accent);
	}

	.toc-nav {
		min-height: 0;
		overflow: hidden;
	}

	.toc-list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-left: 1px solid var(--border);
		max-height: calc(100vh - var(--header-height) - 7rem);
		overflow-y: auto;
		scrollbar-width: thin;
	}

	.toc-item {
		margin: 0;
	}

	.toc-link {
		display: block;
		padding: 0.35rem 0 0.35rem 0.85rem;
		margin-left: -1px;
		border-left: 2px solid transparent;
		color: var(--text-muted);
		text-decoration: none;
		overflow-wrap: break-word;
		transition:
			color 0.15s,
			border-color 0.15s;
	}

	.toc-link:hover {
		color: var(--text);
	}

	.toc-link.active {
		color: var(--accent);
		border-left-color: var(--accent);
		font-weight: 500;
	}

	.toc-item.depth-3 .toc-link {
		padding-left: 1.25rem;
	}

	.toc-item.depth-4 .toc-link {
		padding-left: 1.65rem;
	}

	.toc-item.depth-5 .toc-link {
		padding-left: 2.05rem;
	}

	.toc-item.depth-6 .toc-link {
		padding-left: 2.45rem;
	}

	@media (max-width: 1099px) {
		.toc-root {
			top: auto;
			right: 1rem;
			bottom: 1.5rem;
		}

		.toc-panel {
			position: fixed;
			right: 1rem;
			bottom: 4.5rem;
			width: min(18rem, calc(100vw - 2rem));
			/* max-height: min(24rem, calc(100vh - var(--header-height) - 1rem)); */
		}

		.toc-root[data-collapsed] .toc-panel {
			transform: translateX(calc(100% + 1rem));
		}

		.toc-list {
			max-height: min(18rem, calc(100vh - var(--header-height) - 10rem));
		}
	}
</style>
