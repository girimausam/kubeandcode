---
// Interactive enhancements for article pages:
// 1. Back-to-top floating button
// 2. Heading anchor links with 1-click copy link button
// 3. Collapsible CLI sections / details state persistence via localStorage
---

<button
	type="button"
	id="back-to-top"
	class="back-to-top"
	aria-label="Back to top"
	title="Back to top"
	hidden
>
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="m18 15-6-6-6 6"/>
	</svg>
</button>

<script>
	const initPostEnhancements = () => {
		// 1. Back to top button
		const backToTop = document.getElementById('back-to-top');
		if (backToTop) {
			const onScroll = () => {
				if (window.scrollY > 400) {
					backToTop.removeAttribute('hidden');
				} else {
					backToTop.setAttribute('hidden', 'true');
				}
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			onScroll();

			backToTop.onclick = () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			};
		}

		// 2. Heading permalinks & copy link buttons
		const headings = document.querySelectorAll<HTMLHeadingElement>('.prose :is(h2, h3)[id]');
		headings.forEach((heading) => {
			if (heading.querySelector('.heading-actions')) return;

			const slug = heading.id;
			const actions = document.createElement('span');
			actions.className = 'heading-actions';

			// Direct anchor permalink
			const anchor = document.createElement('a');
			anchor.href = `#${slug}`;
			anchor.className = 'heading-anchor';
			anchor.setAttribute('aria-label', `Direct link to ${heading.textContent}`);
			anchor.textContent = '#';

			// Copy link button
			const copyBtn = document.createElement('button');
			copyBtn.type = 'button';
			copyBtn.className = 'heading-copy-btn';
			copyBtn.setAttribute('aria-label', 'Copy link to this section');
			copyBtn.title = 'Copy link';
			copyBtn.innerHTML = `
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
					<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
				</svg>
				<span class="copy-tooltip">Copied</span>
			`;

			copyBtn.onclick = async (e) => {
				e.stopPropagation();
				const url = `${window.location.origin}${window.location.pathname}#${slug}`;
				try {
					await navigator.clipboard.writeText(url);
					copyBtn.classList.add('copied');
					setTimeout(() => {
						copyBtn.classList.remove('copied');
					}, 2000);
				} catch {
					// Fallback
				}
			};

			actions.appendChild(anchor);
			actions.appendChild(copyBtn);
			heading.appendChild(actions);
		});

		// 3. Collapsible CLI / Details persistence
		const pathKey = window.location.pathname;
		const detailsList = document.querySelectorAll<HTMLDetailsElement>('.prose details, .cli-accordion');
		detailsList.forEach((detail, index) => {
			const storageKey = `details-${pathKey}-${index}`;
			const saved = localStorage.getItem(storageKey);

			if (saved === 'open') {
				detail.open = true;
			} else if (saved === 'closed') {
				detail.open = false;
			}

			detail.addEventListener('toggle', () => {
				localStorage.setItem(storageKey, detail.open ? 'open' : 'closed');
			});
		});
	};

	initPostEnhancements();
	document.addEventListener('astro:page-load', initPostEnhancements);
</script>

<style>
	/* Back to top button */
	.back-to-top {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		z-index: 30;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: var(--bg);
		color: var(--text-muted);
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
	}

	.back-to-top[hidden] {
		display: none;
	}

	.back-to-top:hover {
		color: var(--accent);
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	/* Heading anchor & copy button */
	:global(.prose :is(h2, h3)) {
		position: relative;
	}

	:global(.heading-actions) {
		position: absolute;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		opacity: 0;
		transition: opacity 0.15s ease;
		pointer-events: none;
	}

	:global(.prose :is(h2, h3):hover .heading-actions),
	:global(.heading-actions:focus-within) {
		opacity: 1;
		pointer-events: auto;
	}

	:global(.heading-anchor) {
		color: var(--text-muted);
		text-decoration: none;
		font-family: var(--font-mono);
		font-weight: 400;
		font-size: 0.9em;
		padding: 0.2rem 0.35rem;
		border-radius: 0.25rem;
	}

	:global(.heading-anchor:hover) {
		color: var(--accent);
	}

	:global(.heading-copy-btn) {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.25rem;
		border: 1px solid var(--border);
		border-radius: 0.25rem;
		background: var(--bg-subtle);
		color: var(--text-muted);
		cursor: pointer;
		line-height: 1;
	}

	:global(.heading-copy-btn:hover) {
		color: var(--accent);
		border-color: var(--accent);
	}

	:global(.copy-tooltip) {
		position: absolute;
		bottom: calc(100% + 5px);
		left: 50%;
		transform: translateX(-50%);
		padding: 0.2rem 0.45rem;
		border-radius: 0.25rem;
		background: var(--text);
		color: var(--bg);
		font-size: 0.7rem;
		font-family: var(--font-mono);
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.15s ease;
	}

	:global(.heading-copy-btn.copied .copy-tooltip) {
		opacity: 1;
	}

	/* Details / Collapsible CLI styles */
	:global(.prose details) {
		margin: 1.5rem 0;
		padding: 0.85rem 1.15rem;
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		background: var(--bg-subtle);
	}

	:global(.prose details summary) {
		cursor: pointer;
		font-weight: 600;
		font-size: var(--text-sm);
		color: var(--text);
		user-select: none;
		padding: 0.25rem 0;
		outline-offset: 4px;
	}

	:global(.prose details summary:hover) {
		color: var(--accent);
	}

	:global(.prose details[open]) {
		background: var(--bg);
	}

	:global(.prose details[open] summary) {
		margin-bottom: 0.75rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--border);
	}
</style>

