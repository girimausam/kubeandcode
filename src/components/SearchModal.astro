<div id="search-modal" class="search-modal" hidden>
	<div class="search-modal-backdrop" data-search-close></div>
	<div class="search-modal-dialog" role="dialog" aria-modal="true" aria-label="Search">
		<div id="pagefind-search"></div>
		<p class="search-unavailable" id="search-unavailable" hidden>
			Run npm run build, then npm run preview to use search.
		</p>
	</div>
</div>

<script>
	declare global {
		interface Window {
			PagefindUI?: new (options: {
				element: string;
				showImages?: boolean;
				resetStyles?: boolean;
			}) => void;
		}
	}

	const modal = document.getElementById('search-modal');
	const host = document.getElementById('pagefind-search');
	const unavailable = document.getElementById('search-unavailable');
	const openButtons = () => document.querySelectorAll('[data-search-open]');

	let pagefindReady = false;

	const loadPagefind = () => {
		if (document.querySelector('link[data-pagefind-ui]')) return;

		const link = document.createElement('link');
		link.rel = 'stylesheet';
		link.href = '/pagefind/pagefind-ui.css';
		link.dataset.pagefindUi = 'true';
		document.head.appendChild(link);
	};

	const initPagefind = () =>
		new Promise<boolean>((resolve) => {
			if (pagefindReady) {
				resolve(true);
				return;
			}

			loadPagefind();

			const script = document.createElement('script');
			script.src = '/pagefind/pagefind-ui.js';
			script.onload = () => {
				if (!window.PagefindUI || !host) {
					resolve(false);
					return;
				}

				host.innerHTML = '';
				new window.PagefindUI({
					element: '#pagefind-search',
					showImages: false,
					resetStyles: false,
				});

				pagefindReady = true;
				resolve(true);
			};
			script.onerror = () => resolve(false);
			document.body.appendChild(script);
		});

	const openModal = async () => {
		if (!modal) return;

		modal.hidden = false;
		document.body.classList.add('search-modal-open');

		const ready = await initPagefind();
		if (!ready) {
			unavailable?.removeAttribute('hidden');
			host?.setAttribute('hidden', 'true');
		} else {
			unavailable?.setAttribute('hidden', 'true');
			host?.removeAttribute('hidden');
			host?.querySelector('input')?.focus();
		}
	};

	const closeModal = () => {
		if (!modal) return;
		modal.hidden = true;
		document.body.classList.remove('search-modal-open');
	};

	openButtons().forEach((button) => button.addEventListener('click', openModal));
	document.querySelectorAll('[data-search-close]').forEach((el) => el.addEventListener('click', closeModal));

	document.addEventListener('keydown', (event) => {
		const isOpen = modal && !modal.hidden;

		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault();
			isOpen ? closeModal() : openModal();
			return;
		}

		if (event.key === 'Escape' && isOpen) closeModal();
	});

	document.addEventListener('astro:page-load', () => {
		openButtons().forEach((button) => button.addEventListener('click', openModal));
	});
</script>

<style>
	.search-modal {
		position: fixed;
		inset: 0;
		z-index: 50;
		display: flex;
		justify-content: center;
		padding: 10vh 1rem 2rem;
	}

	.search-modal[hidden] {
		display: none;
	}

	.search-modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.4);
	}

	.search-modal-dialog {
		position: relative;
		width: min(100%, 42rem);
		max-height: 80vh;
		overflow: auto;
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background: var(--bg);
		color: var(--text);
	}

	#pagefind-search :global(.pagefind-ui) {
		--pagefind-ui-text: var(--text);
		--pagefind-ui-background: var(--bg);
		--pagefind-ui-border: var(--border);
		--pagefind-ui-primary: var(--accent);
		--pagefind-ui-tag: var(--bg-subtle);
	}

	#pagefind-search :global(.pagefind-ui__search-input),
	#pagefind-search :global(.pagefind-ui__search-clear) {
		color: var(--text);
		background-color: var(--bg);
	}

	#pagefind-search :global(.pagefind-ui__search-input::placeholder) {
		color: var(--text-muted);
		opacity: 0.7;
	}

	#pagefind-search :global(.pagefind-ui__result-link) {
		color: var(--text);
	}

	#pagefind-search :global(.pagefind-ui__message) {
		color: var(--text-muted);
	}

	#pagefind-search :global(.pagefind-ui__result-excerpt) {
		display: block;
		min-width: 0;
		max-width: 100%;
		/* white-space: nowrap; */
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.search-unavailable {
		margin: 1rem 0 0;
		font-size: var(--text-sm);
		color: var(--text-muted);
		text-align: center;
	}

	:global(body.search-modal-open) {
		overflow: hidden;
	}
</style>
