<div id="search-modal" class="search-modal" hidden>
	<div class="search-modal-backdrop" data-search-close></div>
	<div class="search-modal-dialog" role="dialog" aria-modal="true" aria-label="Search guides">
		<div id="pagefind-search"></div>
		<p class="search-unavailable" id="search-unavailable" hidden>
			Run <code>npm run build</code>, then <code>npm run preview</code> to use search.
		</p>
	</div>
</div>

<script>
	declare global {
		interface Window {
			PagefindUI?: new (options: {
				element: string;
				showImages?: boolean;
				resetStyles?: boolean;
				debounceTimeoutMs?: number;
			}) => void;
		}
	}

	const modal = document.getElementById('search-modal');
	const host = document.getElementById('pagefind-search');
	const unavailable = document.getElementById('search-unavailable');
	const openButtons = () => document.querySelectorAll('[data-search-open]');

	let pagefindReady = false;
	let pagefindLoading = false;

	const base = import.meta.env.BASE_URL;

	const loadPagefindCss = () => {
		if (document.querySelector('link[data-pagefind-ui]')) return;
		const link = document.createElement('link');
		link.rel = 'stylesheet';
		link.href = `${base}pagefind/pagefind-ui.css`;
		link.dataset.pagefindUi = 'true';
		document.head.appendChild(link);
	};

	const initPagefind = () =>
		new Promise<boolean>((resolve) => {
			if (pagefindReady) {
				resolve(true);
				return;
			}
			if (pagefindLoading) {
				const check = setInterval(() => {
					if (pagefindReady) {
						clearInterval(check);
						resolve(true);
					}
				}, 50);
				return;
			}

			pagefindLoading = true;
			loadPagefindCss();

			const script = document.createElement('script');
			script.src = `${base}pagefind/pagefind-ui.js`;
			script.onload = () => {
				if (!window.PagefindUI || !host) {
					pagefindLoading = false;
					resolve(false);
					return;
				}

				host.innerHTML = '';
				new window.PagefindUI({
					element: '#pagefind-search',
					showImages: false,
					resetStyles: false,
					debounceTimeoutMs: 200,
				});

				pagefindReady = true;
				pagefindLoading = false;
				resolve(true);
			};
			script.onerror = () => {
				pagefindLoading = false;
				resolve(false);
			};
			document.body.appendChild(script);
		});

	const openModal = async () => {
		if (!modal) return;

		modal.hidden = false;
		document.body.classList.add('search-modal-open');

		const ready = await initPagefind();
		if (!ready) {
			unavailable?.removeAttribute('hidden');
			host?.setAttribute('hidden', 'true');
		} else {
			unavailable?.setAttribute('hidden', 'true');
			host?.removeAttribute('hidden');
			// Small timeout to allow Pagefind input to render if fresh
			setTimeout(() => {
				host?.querySelector<HTMLInputElement>('input')?.focus();
			}, 50);
		}
	};

	const closeModal = () => {
		if (!modal) return;
		modal.hidden = true;
		document.body.classList.remove('search-modal-open');
	};

	// Lazy load CSS on hover/focus of search buttons
	const wireTriggers = () => {
		openButtons().forEach((button) => {
			button.addEventListener('click', openModal);
			button.addEventListener('mouseenter', loadPagefindCss, { once: true });
			button.addEventListener('focus', loadPagefindCss, { once: true });
		});
	};

	wireTriggers();
	document.querySelectorAll('[data-search-close]').forEach((el) => el.addEventListener('click', closeModal));

	document.addEventListener('keydown', (event) => {
		const isOpen = modal && !modal.hidden;

		// Escape to close
		if (event.key === 'Escape' && isOpen) {
			closeModal();
			return;
		}

		// Ctrl+K / Cmd+K
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault();
			isOpen ? closeModal() : openModal();
			return;
		}

		// '/' key when not typing in form controls
		if (event.key === '/' && !isOpen) {
			const target = event.target as HTMLElement | null;
			const isEditable =
				target &&
				(target.tagName === 'INPUT' ||
					target.tagName === 'TEXTAREA' ||
					target.tagName === 'SELECT' ||
					target.isContentEditable);

			if (!isEditable) {
				event.preventDefault();
				openModal();
			}
		}
	});

	document.addEventListener('astro:page-load', () => {
		wireTriggers();
	});
</script>

<style>
	.search-modal {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		justify-content: center;
		padding: 8vh 1rem 2rem;
	}

	.search-modal[hidden] {
		display: none;
	}

	.search-modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(4px);
	}

	.search-modal-dialog {
		position: relative;
		width: min(100%, 42rem);
		max-height: 80vh;
		overflow-y: auto;
		padding: 1.25rem;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background: var(--bg);
		color: var(--text);
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
	}

	#pagefind-search :global(.pagefind-ui) {
		--pagefind-ui-text: var(--text);
		--pagefind-ui-background: var(--bg);
		--pagefind-ui-border: var(--border);
		--pagefind-ui-primary: var(--accent);
		--pagefind-ui-tag: var(--bg-subtle);
	}

	#pagefind-search :global(.pagefind-ui__search-input),
	#pagefind-search :global(.pagefind-ui__search-clear) {
		color: var(--text);
		background-color: var(--bg-subtle);
		border: 1px solid var(--border);
		border-radius: 0.375rem;
	}

	#pagefind-search :global(.pagefind-ui__search-input:focus) {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}

	#pagefind-search :global(.pagefind-ui__search-input::placeholder) {
		color: var(--text-muted);
		opacity: 0.8;
	}

	#pagefind-search :global(.pagefind-ui__result-link) {
		color: var(--text);
		font-weight: 600;
	}

	#pagefind-search :global(.pagefind-ui__result-link:hover) {
		color: var(--accent);
	}

	#pagefind-search :global(.pagefind-ui__message) {
		color: var(--text-muted);
		font-size: var(--text-sm);
	}

	#pagefind-search :global(.pagefind-ui__result-excerpt) {
		display: block;
		min-width: 0;
		max-width: 100%;
		overflow: hidden;
		color: var(--text-muted);
		line-height: 1.5;
	}

	/* Search match highlight */
	#pagefind-search :global(mark) {
		background-color: var(--accent);
		color: #ffffff;
		padding: 0.1em 0.3em;
		border-radius: 2px;
		font-weight: 600;
	}

	:root[data-theme='dark'] #pagefind-search :global(mark) {
		background-color: var(--accent);
		color: #0b0f19;
	}

	.search-unavailable {
		margin: 1.5rem 0 0;
		font-size: var(--text-sm);
		color: var(--text-muted);
		text-align: center;
	}

	:global(body.search-modal-open) {
		overflow: hidden;
	}
</style>
