---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CodeCopy from '../components/CodeCopy.astro';
import Mermaid from '../components/Mermaid.astro';
import SearchModal from '../components/SearchModal.astro';
import ContentPreview from '../components/ContentPreview.astro';
import type { Post } from '../utils/posts';

export interface BreadcrumbItem {
	name: string;
	url: string;
}

export interface ArticleMeta {
	headline: string;
	description: string;
	author?: string;
	datePublished?: Date;
	dateModified?: Date;
}

interface Props {
	title?: string;
	description?: string;
	posts: Post[];
	canonicalUrl?: string;
	ogImage?: string;
	ogType?: 'website' | 'article';
	articleMeta?: ArticleMeta;
	breadcrumbs?: BreadcrumbItem[];
	noindex?: boolean;
}

const {
	title = 'AWS, EKS & DevOps Guides: Console-First Runbooks | Mausam Giri',
	description = 'Practical AWS, EKS, and DevOps runbooks with console-first workflows, architecture patterns, and production troubleshooting guides by Mausam Giri.',
	posts,
	canonicalUrl,
	ogImage,
	ogType = 'website',
	articleMeta,
	breadcrumbs = [],
	noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteUrl = 'https://mausamgiri.in';

// Compute full canonical URL
const currentPath = Astro.url.pathname.replace(/^\/?/, '/');
const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const blogPath = normalizedPath.startsWith('/blogs/') ? normalizedPath : `/blogs${normalizedPath}`;
const finalCanonical = canonicalUrl || `${siteUrl}${blogPath}`;

// Compute Open Graph image
const defaultOgImage = `${siteUrl}/blogs/images/og-default.png`;
const finalOgImage = ogImage || defaultOgImage;

// Check search / filter query params for noindex
const isFilterOrSearch = Astro.url.searchParams.has('tag') || Astro.url.searchParams.has('q') || Boolean(noindex);
const robotsValue = isFilterOrSearch ? 'noindex, follow' : 'index, follow';

// JSON-LD structured data construction
const jsonLdGraph: Record<string, any>[] = [];

const isHome = currentPath === '/' || currentPath === '/blogs/' || currentPath === '/blogs';

if (isHome) {
	// WebSite & Person on Home
	jsonLdGraph.push({
		'@type': 'WebSite',
		'@id': `${siteUrl}/blogs/#website`,
		url: `${siteUrl}/blogs/`,
		name: 'AWS, EKS & DevOps Guides: Console-First Runbooks | Mausam Giri',
		description: description,
		inLanguage: 'en-US',
		publisher: {
			'@type': 'Person',
			'@id': `${siteUrl}/#person`,
			name: 'Mausam Giri',
			url: siteUrl,
			jobTitle: 'Cloud & DevOps Architect',
			sameAs: [
				'https://github.com/mausamgiri',
				'https://linkedin.com/in/mausamgiri',
			],
		},
	});

	jsonLdGraph.push({
		'@type': 'Person',
		'@id': `${siteUrl}/#person`,
		name: 'Mausam Giri',
		url: siteUrl,
		jobTitle: 'Cloud & DevOps Architect',
		sameAs: [
			'https://github.com/mausamgiri',
			'https://linkedin.com/in/mausamgiri',
		],
	});
} else if (articleMeta) {
	// BlogPosting on posts
	const pubDate = articleMeta.datePublished || new Date();
	const modDate = articleMeta.dateModified || pubDate;

	jsonLdGraph.push({
		'@type': 'BlogPosting',
		'@id': `${finalCanonical}#article`,
		isPartOf: {
			'@type': 'WebSite',
			'@id': `${siteUrl}/blogs/#website`,
		},
		headline: articleMeta.headline,
		description: articleMeta.description,
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': finalCanonical,
		},
		author: {
			'@type': 'Person',
			'@id': `${siteUrl}/#person`,
			name: articleMeta.author || 'Mausam Giri',
			url: siteUrl,
		},
		publisher: {
			'@type': 'Person',
			'@id': `${siteUrl}/#person`,
			name: 'Mausam Giri',
			url: siteUrl,
		},
		datePublished: pubDate.toISOString(),
		dateModified: modDate.toISOString(),
		image: finalOgImage,
		inLanguage: 'en-US',
	});
}

// BreadcrumbList if breadcrumbs provided
if (breadcrumbs.length > 0) {
	jsonLdGraph.push({
		'@type': 'BreadcrumbList',
		'@id': `${finalCanonical}#breadcrumb`,
		itemListElement: breadcrumbs.map((crumb, idx) => ({
			'@type': 'ListItem',
			position: idx + 1,
			name: crumb.name,
			item: crumb.url,
		})),
	});
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robotsValue} />
		<link rel="canonical" href={finalCanonical} />

		<!-- Open Graph -->
		<meta property="og:site_name" content="Mausam Giri | AWS & DevOps Guides" />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={finalCanonical} />
		<meta property="og:image" content={finalOgImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={finalOgImage} />
		<meta name="twitter:creator" content="@mausamgiri" />

		<!-- Favicon & Feeds -->
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="AWS, EKS & DevOps Guides | Mausam Giri"
			href={`${siteUrl}/blogs/feed.xml`}
		/>

		<!-- Google Fonts (Inter & JetBrains Mono) + Material Symbols -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0"
		/>

		<!-- Structured Data (JSON-LD) -->
		{
			jsonLdGraph.length > 0 && (
				<script
					type="application/ld+json"
					is:inline
					set:html={JSON.stringify({
						'@context': 'https://schema.org',
						'@graph': jsonLdGraph,
					})}
				/>
			)
		}

		<script is:inline define:vars={{ base }}>
			(function () {
				const storageKey = 'theme';
				const theme =
					localStorage.getItem(storageKey) ||
					(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.dataset.theme = theme;

				// Instant redirect from ?tag=X to /blogs/tags/X/
				if (window.location.search && window.location.search.length > 1) {
					const params = new URLSearchParams(window.location.search);
					const tag = params.get('tag');
					if (tag) {
						window.location.replace(`${base}tags/${encodeURIComponent(tag)}/`);
						return;
					}
					const r = document.querySelector('meta[name="robots"]');
					if (r) r.setAttribute('content', 'noindex, follow');
				}
			})();
		</script>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<Header>
			<ThemeToggle slot="actions" />
		</Header>
		<SearchModal />
		<ContentPreview />
		<main class="site-main" id="main-content">
			<slot />
		</main>
		<Footer posts={posts} />
		<CodeCopy />
		<Mermaid />
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		top: -9999px;
		left: 1rem;
		z-index: 1000;
		padding: 0.6rem 1.2rem;
		background: var(--accent);
		color: #ffffff;
		font-weight: 600;
		font-size: var(--text-sm);
		border-radius: 0.35rem;
		text-decoration: none;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
	}

	.skip-link:focus {
		top: 1rem;
	}
</style>
