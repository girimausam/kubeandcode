{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/tag/:tag*",
      "destination": "/tags/:tag*",
      "permanent": true
    },
    {
      "source": "/blogs/tag/:tag*",
      "destination": "/blogs/tags/:tag*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blogs/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/blogs/sitemap-index.xml",
      "destination": "/sitemap-index.xml"
    },
    {
      "source": "/blogs/feed.xml",
      "destination": "/feed.xml"
    },
    {
      "source": "/blogs/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/blogs/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff2?|ttf|otf|eot|png|jpe?g|webp|avif|gif|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!.*\\.[^/]+$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
